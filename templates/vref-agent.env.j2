# Managed by Ansible (role vantage_agents). Changes are overwritten.
{#- Escape a value for a double-quoted systemd EnvironmentFile entry. #}
{%- macro q(v) %}{{ v | replace('\\', '\\\\') | replace('"', '\\"') }}{% endmacro -%}
VREF_AGENT_API_URL="{{ vantage_agents_vref_api_url }}"
VREF_AGENT_OIDC_ISSUER="{{ vantage_agents_oidc_base_url | trim('/') }}{{ vantage_agents_realm_path }}"
VREF_AGENT_CLIENT_ID="{{ q(vantage_agents_client_id) }}"
VREF_AGENT_CLIENT_SECRET="{{ q(vantage_agents_client_secret) }}"
VREF_AGENT_SLURMRESTD_URL="{{ vantage_agents_slurmrestd_url }}"
VREF_AGENT_SLURM_TOKEN_FILE="{{ vantage_agents_vref_token_file }}"
{% if vantage_agents_vref_container_engine | length > 0 %}
VREF_AGENT_CONTAINER_ENGINE="{{ vantage_agents_vref_container_engine }}"
{% endif %}
