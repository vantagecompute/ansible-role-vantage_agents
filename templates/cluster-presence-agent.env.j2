{%- macro q(v) %}{{ v | replace('\\', '\\\\') | replace('"', '\\"') }}{% endmacro -%}
# Managed by Ansible (role vantage_agents). Changes are overwritten.
CLUSTER_PRESENCE_AGENT_OIDC_DOMAIN="{{ vantage_agents_oidc_base_url | regex_replace('^https?://', '') | trim('/') }}{{ vantage_agents_realm_path }}"
CLUSTER_PRESENCE_AGENT_OIDC_CLIENT_ID="{{ q(vantage_agents_client_id) }}"
CLUSTER_PRESENCE_AGENT_OIDC_CLIENT_SECRET="{{ q(vantage_agents_client_secret) }}"
CLUSTER_PRESENCE_AGENT_OIDC_USE_HTTPS="{{ 'false' if vantage_agents_oidc_base_url is match('^http://') else 'true' }}"
CLUSTER_PRESENCE_AGENT_BASE_API_URL="{{ vantage_agents_api_base_url | trim('/') }}"
CLUSTER_PRESENCE_AGENT_INTERVAL_SECONDS="{{ vantage_agents_presence_interval_seconds }}"
